{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "unified-server.ts",
    "services/*/src/**/*",
    "shared/**/*"
  ],
  "exclude": ["node_modules", "dist", "services/*/dist"]
}
