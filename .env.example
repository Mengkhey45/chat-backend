# Copy to .env and fill in. Never commit .env — it is gitignored.

# ---------- Core ----------
PORT=4000
NODE_ENV=development
# Shown as the sender name on verification and password-reset emails.
APP_NAME=Chatly

# Comma-separated list of origins allowed to call the API and open a socket.
# Required in production; localhost ports are added automatically in dev.
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---------- Databases ----------
# Use "localhost" when running `pnpm dev`, the service names when using docker compose.
MONGO_URI=mongodb://localhost:27017/chat
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
# At least 32 characters in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Short-lived bearer token held in browser memory.
ACCESS_TOKEN_TTL=15m
# Long-lived httpOnly refresh cookie, rotated on every use.
REFRESH_TOKEN_TTL_DAYS=30

# ---------- Email ----------
# Preferred: Resend. An HTTPS API, so it works on hosts that block SMTP ports.
# Free tier: 3,000/month. Requires a verified sending domain to email real users.
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_CODE_EXPIRES_MIN=15

# Fallback: Gmail SMTP. Development only — Gmail caps at ~500 recipients/day and
# app passwords are revoked whenever 2FA is toggled. Needs a 16-character app
# password from https://myaccount.google.com/apppasswords (not your login password).
SMTP_USER=
SMTP_PASS=

# ---------- Calls (WebRTC) ----------
# STUN is built in and free. TURN relays media for the ~10-20% of calls that
# cannot connect peer-to-peer (symmetric NAT, strict firewalls, some carriers).
# Without it those calls fail. Self-host coturn, or use a hosted provider.
TURN_URL=
# Preferred: coturn's REST scheme — the server mints short-lived credentials.
#   turnserver --use-auth-secret --static-auth-secret=<this value>
TURN_SECRET=
# Or static credentials, if your provider only offers those.
TURN_USERNAME=
TURN_CREDENTIAL=

# ---------- Object storage (Cloudflare R2) ----------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://<your-public-bucket-domain>

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
